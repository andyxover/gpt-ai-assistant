# Required
ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=postgresql://postgres.PROJECT:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional — model selection (defaults below)
CLAUDE_MODEL=claude-sonnet-4-6
VALIDATOR_MODEL=claude-opus-4-7

# Optional — server
PORT=3000

# LINE bot — leave DRY_RUN=true for local dev (no real LINE calls)
LINE_API_DRY_RUN=true
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
